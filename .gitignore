# Byte-compiled
__pycache__/
*.py[cod]
*.pyc

# Virtual environments
.venv/
venv/
env/

# Raw input data
data_raw/
*.csv
*.txt
*.xlsx

# Allow parquet outputs
!data_output/*.parquet

# Ignore output CSVs
data_output/*.csv

# Streamlit config
.streamlit/

# System files
.DS_Store
Thumbs.db

# Private side business (not tracked)
private/

# Claude Code per-machine local settings
.claude/settings.local.json
